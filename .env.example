# Google Analytics 4 measurement ID (G-XXXXXXX). Leave empty to disable GA entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console HTML-tag verification token. Leave empty to omit the meta tag.
NEXT_PUBLIC_GSC_VERIFICATION=
# Google Drive folder ID for the Our Work gallery (the folder is shared "Anyone with the link: Viewer").
GOOGLE_DRIVE_FOLDER_ID=
# Server-only Google Cloud API key restricted to the Drive API. Never prefix with NEXT_PUBLIC_.
GOOGLE_DRIVE_API_KEY=
# Server-only Resend API key used to send contact form enquiries. Never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
# Address that receives contact form enquiries, e.g. sales@edmondsonlifting.co.uk
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. Edmondson Lifting Website <website@edmondsonlifting.co.uk>
CONTACT_FROM_EMAIL=
